Output demo/demo.gif

Set Shell "powershell"
Set FontSize 14
Set Width 960
Set Height 620
Set Theme "TokyoNight"
Set TypingSpeed 50ms
Set Padding 16

Type "Clear-Host"
Enter
Sleep 500ms

Type "uv run amon-hen"
Enter
Sleep 3s

Type "/index demo/cctv-people-demo.webm"
Enter
Sleep 7s

Type "a person holding an umbrella"
Enter
Sleep 4s

Type "a car driving on the road"
Enter
Sleep 4s

Type "/exit"
Enter
Sleep 2s

